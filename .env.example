# Smart Factory HSE — environment configuration
# Copy this file to ".env" and fill in your own values. The .env file is gitignored
# so your keys never get committed. All values are OPTIONAL — without them the app
# still runs, but AI Agent notifications fall back to template text and "local only"
# (nothing is actually sent out).

# --- Gemini (writes the notification wording; free tier) ---------------------------
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. gemini-flash-lite-latest is the default — its free-tier daily quota is much
# higher (~1000-1500 RPD) than full "flash" models like gemini-3.6-flash (~20 RPD).
GEMINI_MODEL=gemini-flash-lite-latest

# --- Notification channel: pick ONE ------------------------------------------------
# Option A (easiest) — Discord webhook. Just one URL, no bot:
#   Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Optional SECOND Discord channel, just for "action taken" remediation updates — keeps
# them separate from the new-detection channel above. Leave empty to send everything to
# the one channel. Same setup: create another webhook in a different Discord channel.
DISCORD_WEBHOOK_URL_ACTIONS=

# Option B — Telegram (used only if DISCORD_WEBHOOK_URL is empty).
# 1. In Telegram, chat @BotFather -> /newbot -> copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# 2. Send any message to your new bot, then open in a browser:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Find "chat":{"id":123456789 -> that number is your chat id.
TELEGRAM_CHAT_ID=
